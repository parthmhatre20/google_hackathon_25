# Google Gemini API Keys
# Option 1: Single API key
GEMINI_API_KEY=your_api_key_here

# Option 2: Multiple API keys for rotation (comma-separated)
# When one key hits quota, system automatically switches to next key
# Perfect for team projects with 4 members!
GEMINI_API_KEYS=key1_here,key2_here,key3_here,key4_here

# Firebase Configuration (optional)
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# Flask Secret Key (change in production)
FLASK_SECRET_KEY=your-secret-key-here

# How it works:
# - System tries keys in order: key1 → key2 → key3 → key4
# - On 429 quota error, automatically rotates to next key
# - Logs which key is being used: "🔄 Rotated to API key #2"
# - Works for both answer analysis and question generation
# - If all keys exhausted, falls back to hardcoded responses
